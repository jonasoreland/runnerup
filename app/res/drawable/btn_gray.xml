<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient android:angle="270" android:endColor="#222222" android:startColor="#444444" />
            <corners android:radius="5dp" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape>
            <gradient android:angle="270" android:endColor="#171717" android:startColor="#777777" />
            <corners android:radius="5dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="270" android:endColor="#222222" android:startColor="#555555" />
            <corners android:radius="5dp" />
        </shape>
    </item>
</selector>
