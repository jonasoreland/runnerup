{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relven.app/schemas/exercise-library-v1.schema.json",
  "title": "Relven Exercise Library v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "libraryRevision", "exercises"],
  "properties": {
    "format": { "const": "relven.exercise-library" },
    "schemaVersion": { "const": 1 },
    "libraryRevision": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "exercises": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/exercise" }
    }
  },
  "$defs": {
    "localizedName": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "sv"],
      "properties": {
        "en": { "type": "string", "minLength": 1, "maxLength": 120 },
        "sv": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "localizedInstructions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "sv"],
      "properties": {
        "en": { "$ref": "#/$defs/instructionSteps" },
        "sv": { "$ref": "#/$defs/instructionSteps" }
      }
    },
    "instructionSteps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exerciseId",
        "revision",
        "name",
        "category",
        "movementPattern",
        "muscleGroups",
        "equipment",
        "instructions"
      ],
      "properties": {
        "exerciseId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "revision": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "name": { "$ref": "#/$defs/localizedName" },
        "category": {
          "enum": ["lower_body", "upper_body", "core", "warmup_mobility"]
        },
        "movementPattern": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" },
        "muscleGroups": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "enum": [
              "abdominals",
              "back",
              "calves",
              "chest",
              "glutes",
              "hamstrings",
              "hips",
              "obliques",
              "quadriceps",
              "shoulders",
              "triceps"
            ]
          }
        },
        "equipment": {
          "type": "array",
          "maxItems": 12,
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        },
        "instructions": { "$ref": "#/$defs/localizedInstructions" }
      }
    }
  }
}
